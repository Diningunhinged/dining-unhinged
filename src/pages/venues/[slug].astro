---
import MainLayout from "../../layouts/MainLayout.astro";
import { client } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Disclosure from "../../components/Disclosure.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import OverallRating from "../../components/OverallRating.astro";
import ReviewScorecard from "../../components/ReviewScorecard.astro";

export async function getStaticPaths() {
  const reviews = await client.fetch(`
    *[_type == "restaurantReview"]{
      "slug": slug.current
    }
  `);

  return reviews.map((review: { slug: string }) => ({
    params: {
      slug: review.slug,
    },
  }));
}

const { slug } = Astro.params;

const review = await client.fetch(
  `
  *[_type == "restaurantReview" && slug.current == $slug][0]{
    title,
    deck,
    scores,
    publishedDate,
    heroImage,
    gallery,
    body,
    hosted,
    disclosure,
    venueType,
    venue->{
      name,
      city,
      province,
      cuisine
    }
  }
  `,
  { slug }
);

if (!review) {
  throw new Error(`Venue review not found: ${slug}`);
}

---

<MainLayout title={`${review.title} | Dining Unhinged`}>

  <section class="article-hero">

    <a href="/venues" class="back-link">
      ← Back to Venues
    </a>

    <p class="article-category">
      {review.venueType?.toUpperCase()} • {review.venue.city}, {review.venue.province}
    </p>

    <h1>{review.title}</h1>

    <OverallRating scores={review.scores} />

    <p class="article-deck">
      {review.deck}
    </p>

  </section>

  <Disclosure
    hosted={review.hosted}
    disclosure={review.disclosure}
  />

  <section class="article-image">

    <ImageGallery
      heroImage={review.heroImage}
      gallery={review.gallery}
      title={review.title}
    />

  </section>

  <section class="review-details">

    <div class="detail-box">
      <span class="detail-label">Venue</span>
      <strong>{review.venue.name}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Location</span>
      <strong>{review.venue.city}, {review.venue.province}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Cuisine</span>
      <strong>{review.venue.cuisine}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Published</span>
      <strong>{review.publishedDate}</strong>
    </div>

  </section>

  <section class="article-body">

    <PortableText value={review.body} />

  </section>

  <ReviewScorecard
  scores={review.scores}
/>

</MainLayout>