---
import MainLayout from "../layouts/MainLayout.astro";
import ReviewCard from "../components/ReviewCard.astro";
import { client } from "../lib/sanity";
import { urlFor } from "../lib/image";
import { calculateOverall } from "../lib/calculateOverall";

const reviews = await client.fetch(`
  *[_type == "restaurantReview"] | order(publishedDate desc){
    title,
    scores,
    excerpt,
    heroImage,
    "slug": slug.current,
    venue->{
      cuisine
    }
  }
`);
---

<MainLayout title="Venues | Dining Unhinged">

  <section>

    <h1>Venues</h1>

    <p class="featured-summary">
      Every venue we've reviewed, from restaurants and breweries to wineries,
      distilleries, cafés, and everything in between. No paid rankings. No
      sponsored placements. Just honest opinions and memorable experiences.
    </p>

    <div class="restaurant-grid">

      {reviews.map((review: any) => (

        <ReviewCard
          title={review.title}
          rating={calculateOverall(review.scores)}
          category={review.venue?.cuisine ?? ""}
          excerpt={review.excerpt}
          image={urlFor(review.heroImage).width(800).url()}
          url={`/venues/${review.slug}`}
        />

      ))}

    </div>

  </section>

</MainLayout>