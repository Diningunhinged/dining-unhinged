---
import MainLayout from "../layouts/MainLayout.astro";
import { client } from "../lib/sanity";
import { urlFor } from "../lib/image";

const repeatOffenders = await client.fetch(`
*[_type == "repeatOffender"][0]{

  futureCamProblem->{
    _type,
    title,
    slug,
    excerpt,
    heroImage
  },

  liquidCourageLaureate->{
    _type,
    title,
    slug,
    excerpt,
    heroImage
  },

  emptyTank->{
    _type,
    title,
    slug,
    excerpt,
    heroImage
  },

  pleasantHumans->{
    _type,
    title,
    slug,
    excerpt,
    heroImage
  },

  didntHappen->{
    _type,
    title,
    slug,
    excerpt,
    heroImage
  }

}
`);

const getLink = (review: any) => {
  if (!review) return "#";

  return review._type === "cocktailReview"
    ? `/drinks/${review.slug.current}`
    : `/venues/${review.slug.current}`;
};
---

<MainLayout title="The Repeat Offenders | Dining Unhinged">

  <section class="article-hero">

    <p class="article-category">
      DINING UNHINGED
    </p>

    <h1>The Repeat Offenders</h1>

    <p class="article-deck">
      The places we'd happily return to, despite every promise to try somewhere new.
    </p>

  </section>

  <section class="restaurant-grid">

    {repeatOffenders.futureCamProblem && (
      <article class="review-card">

        <img
          src={urlFor(repeatOffenders.futureCamProblem.heroImage).width(900).url()}
          alt={repeatOffenders.futureCamProblem.title}
          class="review-image"
        />

        <div class="review-body">

          <p class="review-category">
            FUTURE CAM'S PROBLEM
          </p>

          <h3>{repeatOffenders.futureCamProblem.title}</h3>

          <p class="review-excerpt">
            {repeatOffenders.futureCamProblem.excerpt}
          </p>

          <a
            href={getLink(repeatOffenders.futureCamProblem)}
            class="read-story"
          >
            Read the Review →
          </a>

        </div>

      </article>
    )}

    {repeatOffenders.liquidCourageLaureate && (
      <article class="review-card">

        <img
          src={urlFor(repeatOffenders.liquidCourageLaureate.heroImage).width(900).url()}
          alt={repeatOffenders.liquidCourageLaureate.title}
          class="review-image"
        />

        <div class="review-body">

          <p class="review-category">
            LIQUID COURAGE LAUREATE
          </p>

          <h3>{repeatOffenders.liquidCourageLaureate.title}</h3>

          <p class="review-excerpt">
            {repeatOffenders.liquidCourageLaureate.excerpt}
          </p>

          <a
            href={getLink(repeatOffenders.liquidCourageLaureate)}
            class="read-story"
          >
            Read the Review →
          </a>

        </div>

      </article>
    )}

    {repeatOffenders.emptyTank && (
      <article class="review-card">

        <img
          src={urlFor(repeatOffenders.emptyTank.heroImage).width(900).url()}
          alt={repeatOffenders.emptyTank.title}
          class="review-image"
        />

        <div class="review-body">

          <p class="review-category">
            THE EMPTY TANK
          </p>

          <h3>{repeatOffenders.emptyTank.title}</h3>

          <p class="review-excerpt">
            {repeatOffenders.emptyTank.excerpt}
          </p>

          <a
            href={getLink(repeatOffenders.emptyTank)}
            class="read-story"
          >
            Read the Review →
          </a>

        </div>

      </article>
    )}

    {repeatOffenders.pleasantHumans && (
      <article class="review-card">

        <img
          src={urlFor(repeatOffenders.pleasantHumans.heroImage).width(900).url()}
          alt={repeatOffenders.pleasantHumans.title}
          class="review-image"
        />

        <div class="review-body">

          <p class="review-category">
            UNREASONABLY PLEASANT HUMANS
          </p>

          <h3>{repeatOffenders.pleasantHumans.title}</h3>

          <p class="review-excerpt">
            {repeatOffenders.pleasantHumans.excerpt}
          </p>

          <a
            href={getLink(repeatOffenders.pleasantHumans)}
            class="read-story"
          >
            Read the Review →
          </a>

        </div>

      </article>
    )}

    {repeatOffenders.didntHappen && (
      <article class="review-card">

        <img
          src={urlFor(repeatOffenders.didntHappen.heroImage).width(900).url()}
          alt={repeatOffenders.didntHappen.title}
          class="review-image"
        />

        <div class="review-body">

          <p class="review-category">
            IF I DON'T LOG IT, IT DIDN'T HAPPEN
          </p>

          <h3>{repeatOffenders.didntHappen.title}</h3>

          <p class="review-excerpt">
            {repeatOffenders.didntHappen.excerpt}
          </p>

          <a
            href={getLink(repeatOffenders.didntHappen)}
            class="read-story"
          >
            Read the Review →
          </a>

        </div>

      </article>
    )}

  </section>

</MainLayout>