---
import MainLayout from "../../layouts/MainLayout.astro";
import { client } from "../../lib/sanity";
import { urlFor } from "../../lib/image";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const drinks = await client.fetch(`
    *[_type == "cocktailReview"]{
      "slug": slug.current
    }
  `);

  return drinks.map((drink: { slug: string }) => ({
    params: {
      slug: drink.slug,
    },
  }));
}

const { slug } = Astro.params;

const drink = await client.fetch(
  `
  *[_type == "cocktailReview" && slug.current == $slug][0]{
    title,
    storyHook,
    drinkType,
    spirit,
    rating,
    publishedDate,
    heroImage,
    body,
    venue->{
      name,
      city,
      province
    }
  }
  `,
  { slug }
);

if (!drink) {
  throw new Error(`Drink review not found: ${slug}`);
}
---

<MainLayout title={`${drink.title} | Dining Unhinged`}>

  <section class="article-hero">

    <a href="/drinks" class="back-link">
      ← Back to Drinks
    </a>

    <p class="article-category">
      {drink.drinkType?.toUpperCase()} • {drink.venue.city}, {drink.venue.province}
    </p>

    <h1>{drink.title}</h1>

    <div class="article-stars">
      {"★".repeat(drink.rating ?? 5)}
    </div>

    <p class="article-deck">
      {drink.storyHook}
    </p>

  </section>

  <section class="article-image">

    <img
      src={urlFor(drink.heroImage).width(1600).url()}
      alt={drink.title}
    />

  </section>

  <section class="review-details">

    <div class="detail-box">
      <span class="detail-label">Venue</span>
      <strong>{drink.venue.name}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Location</span>
      <strong>{drink.venue.city}, {drink.venue.province}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Primary Spirit</span>
      <strong>{drink.spirit}</strong>
    </div>

    <div class="detail-box">
      <span class="detail-label">Published</span>
      <strong>{drink.publishedDate}</strong>
    </div>

  </section>

  <section class="article-body">

    <PortableText value={drink.body} />

  </section>

</MainLayout>