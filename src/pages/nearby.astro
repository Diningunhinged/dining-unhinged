---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Questionable Decisions Nearby | Dining Unhinged"
  description="Discover nearby Dining Unhinged venue and drink reviews."
>

<section class="nearby-hero">

  <div class="container">

    <p class="eyebrow">
      NEW FEATURE
    </p>

    <h1>Questionable Decisions Nearby</h1>

    <p class="lead">
      Your next questionable decision is probably closer than you think.
      Whether it's dinner, a cocktail, or somewhere worth lingering,
      Dining Unhinged will help you find it.
    </p>

    <button
      id="find-nearby"
      class="hero-button"
    >
      Find My Next Mistake
    </button>

    <p
      id="nearby-status"
      class="nearby-status"
    >
      We'll only use your location to find nearby Dining Unhinged reviews.
        </p>

  </div>

</section>

<section
  class="nearby-filter"
  id="nearby-filter"
  hidden
>

  <div class="container">

    <div class="nearby-search-bar">

      <div class="search-box">

        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>

        <input
          id="nearby-search"
          type="text"
          placeholder=""
        >

      </div>

      <div class="segmented-control">

        <button
          class="segment active"
          data-filter="all"
        >
          All
        </button>

        <button
          class="segment"
          data-filter="venue"
        >
          Places
        </button>

        <button
          class="segment"
          data-filter="drink"
        >
          Drinks
        </button>

      </div>

    </div>

  </div>

</section>

<section class="nearby-results">

  <div class="container">

    <div
      id="results"
      class="nearby-grid"
    >

      <div class="empty-state">

        <h2>Ready when you are.</h2>

        <p>
          Press the button above and we'll start looking for
          questionable decisions nearby.
        </p>

      </div>

    </div>

  </div>

</section>

<script type="module">

function distanceKm(lat1, lon1, lat2, lon2) {

    const R = 6371;

    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;

    const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(lat1 * Math.PI / 180) *
        Math.cos(lat2 * Math.PI / 180) *
        Math.sin(dLon / 2) *
        Math.sin(dLon / 2);

    return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));

}

const icons = {

    Restaurant: "🍽",
    Brewery: "🍺",
    Winery: "🍷",
    Distillery: "🥃",
    "Cocktail Bar": "🍸",
    Pub: "🍺",
    Lounge: "🥂",
    Café: "☕",
    Bakery: "🥐",
    Market: "🛒",

    Cocktail: "🍸",
    Beer: "🍺",
    Wine: "🍷",
    Whisky: "🥃",
    Spirit: "🥃",
    Coffee: "☕",
    Tea: "🫖",
    Mocktail: "🍹",
    "Zero-Proof": "🥤",
    Flight: "🛫",
    "Seasonal Feature": "⭐"

};

const button = document.querySelector("#find-nearby");
const status = document.querySelector("#nearby-status");
const results = document.querySelector("#results");
const filter = document.querySelector("#nearby-filter");
const searchInput = document.querySelector("#nearby-search");

const placeholders = [
    "Search Your Soul...",
    "Search Your Standards...",
    "Search Your Regrets...",
    "Search Your Wallet...",
    "Search For Better Decisions...",
    "Search For Trouble...",
    "Search Your Last Paycheque...",
    "Search For Tomorrow's Hangover...",
    "Search Responsibly... or Don't."
];

searchInput.placeholder =
    placeholders[Math.floor(Math.random() * placeholders.length)];

    function renderStars(rating) {

    rating = Number(rating) || 0;

    const stars = Array.from({ length: 5 }, (_, i) => {

        const fill = Math.max(
            0,
            Math.min(100, Math.round((rating - i) * 100))
        );

        return `
            <div class="du-star">

                <svg viewBox="0 0 24 24" class="du-star-empty">
                    <path d="M12 2l2.9 6.2 6.8.6-5 4.5 1.5 6.7L12 16.9 5.8 20l1.5-6.7-5-4.5 6.8-.6z"/>
                </svg>

                <div class="du-star-fill" style="width:${fill}%">

                    <svg viewBox="0 0 24 24" class="du-star-gold">
                        <path d="M12 2l2.9 6.2 6.8.6-5 4.5 1.5 6.7L12 16.9 5.8 20l1.5-6.7-5-4.5 6.8-.6z"/>
                    </svg>

                </div>

            </div>
        `;

    }).join("");

    return `
        <div class="du-stars">
            ${stars}
            <span class="du-rating">${rating.toFixed(1)}</span>
        </div>
    `;
}

button.addEventListener("click", async () => {

    results.innerHTML = "";

    filter.hidden = true;

    if (!navigator.geolocation) {

        status.textContent =
            "Apparently your browser doesn't believe in questionable decisions.";

        return;

    }

    status.innerHTML = `
        <div class="nearby-loading">

            <div class="loading-spinner"></div>

            <span>

                Looking for poor decisions...

            </span>

        </div>
    `;

    navigator.geolocation.getCurrentPosition(

        async (position) => {

            try {

                const lat = position.coords.latitude;
                const lng = position.coords.longitude;

                const response = await fetch("/api/nearby.json");

                const items = await response.json();

                items.forEach(item => {

                    item.distance = distanceKm(
                        lat,
                        lng,
                        item.venue.location.lat,
                        item.venue.location.lng
                    );

                });

                items.sort((a, b) => a.distance - b.distance);

                status.textContent =
    `${items.length} questionable decision${items.length === 1 ? "" : "s"} within striking distance.`;

if (items.length > 0) {

    filter.hidden = false;

}

                if (items.length === 0) {

                    results.innerHTML = `

                        <div class="empty-state">

                            <h2>

                                Apparently you're surrounded by restraint.

                            </h2>

                            <p>

                                Dining Unhinged hasn't reviewed anything nearby...
                                yet.

                            </p>

                        </div>

                    `;

                    return;

                }

                items.forEach(item => {

                    const icon =
                        icons[item.category] ||
                        (item.type === "drink" ? "🍸" : "🍽");

                    const card =
    document.createElement("article");

card.className = "nearby-card";

card.dataset.type = item.type;

card.dataset.search = [

    item.title,

    item.venue.name,

    item.venue.city,

    item.venue.province,

    item.category,

    item.venue.cuisine ?? ""

].join(" ").toLowerCase();

                    card.innerHTML = `
                    <img
    src="${item.heroImage ?? "/images/placeholder.jpg"}"
    alt="${item.title}"
>

<div class="nearby-content">

    <div class="nearby-type">

        ${icon}

        ${(item.category || item.type).toUpperCase()}

    </div>

    <div class="nearby-stars">

    ${renderStars(item.rating)}

</div>

    <h2>

        ${item.title}

    </h2>

    <p class="nearby-venue">

        ${item.venue.name}

    </p>

    <p class="nearby-location">

        ${item.venue.city}, ${item.venue.province}

    </p>

    <p class="nearby-distance">

        📍 ${item.distance.toFixed(1)} km away

    </p>

    <div class="nearby-actions">

        <a
            href="/${item.type === "drink" ? "drinks" : "venues"}/${item.slug}"
            class="hero-button"
        >
            Read the Review →
        </a>

        ${
            item.venue.googleMaps
                ? `
                <a
                    href="${item.venue.googleMaps}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="secondary-button"
                >
                    Open in Maps
                </a>
                `
                : ""
        }

    </div>

</div>

`;

                    results.appendChild(card);

                });

            } catch (error) {

                console.error(error);

                status.textContent =
                    "Something went wrong while looking for poor decisions.";

                results.innerHTML = `

                    <div class="empty-state">

                        <h2>

                            Well... that was unfortunate.

                        </h2>

                        <p>

                            Dining Unhinged ran into an unexpected issue while
                            searching for nearby reviews.

                            Please try again in a moment.

                        </p>

                    </div>

                `;

            }

        },
                () => {

            status.textContent =
                "We can't point you toward poor decisions if we don't know roughly where you are.";

            results.innerHTML = `

                <div class="empty-state">

                    <h2>

                        Location Needed

                    </h2>

                    <p>

                        Enable location services and we'll find the closest
                        Dining Unhinged recommendations around you.

                    </p>

                </div>

            `;

        }

    );

});
function filterResults() {

    const activeFilter =
        document.querySelector(".segment.active")?.dataset.filter ?? "all";

    const search =
        searchInput.value.trim().toLowerCase();

    document.querySelectorAll(".nearby-card").forEach(card => {

        const type = card.dataset.type;

        const text = card.dataset.search;

        const matchesFilter =
            activeFilter === "all" ||
            activeFilter === type;

        const matchesSearch =
            text.includes(search);

        card.style.display =
            matchesFilter && matchesSearch
                ? ""
                : "none";

    });

}
const filterButtons = document.querySelectorAll(".segment");

filterButtons.forEach(button => {

    button.addEventListener("click", () => {

        filterButtons.forEach(btn =>
            btn.classList.remove("active")
        );

        button.classList.add("active");

        filterResults();

    });

});

searchInput.addEventListener("input", () => {

    filterResults();

});

</script>

</MainLayout>
                    