---
import { client } from "../lib/sanity";
import { urlFor } from "../lib/image";

const review = await client.fetch(`
  *[_type == "restaurantReview"]
  | order(publishedDate desc)[0]{
    title,
    slug,
    rating,
    excerpt,
    heroImage,
    venue->{
      name,
      city,
      province
    }
  }
`);
---

{review && (
<section id="featured-story" class="featured-story">

  <div class="featured-image">
    {review.heroImage && (
      <img
        src={urlFor(review.heroImage).width(1200).url()}
        alt={review.title}
      />
    )}
  </div>

  <div class="featured-content">

    <p class="featured-label">
      FEATURED REVIEW
    </p>

    <h2>{review.title}</h2>

    <p class="featured-location">
      {review.venue?.name} • {review.venue?.city}, {review.venue?.province}
    </p>

    <div class="featured-stars">
      {"★".repeat(review.rating ?? 0)}
    </div>

    {review.excerpt && (
      <blockquote>
        "{review.excerpt}"
      </blockquote>
    )}

    <a
      href={`/venues/${review.slug.current}`}
      class="hero-button"
    >
      Read the Review →
    </a>

  </div>

</section>
)}